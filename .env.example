# ===========================================
# ProspectIQ Environment Variables
# Copy this to .env.local and fill in values
# ===========================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_GROWTH_ANNUAL=price_...

# Anthropic (Claude API for prospect research)
ANTHROPIC_API_KEY=sk-ant-...

# Companies House (free API key from developer.company-information.service.gov.uk)
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key

# FCA Register (free API key from register.fca.org.uk/Developer/s/)
FCA_REGISTER_API_KEY=your-fca-api-key
FCA_REGISTER_EMAIL=your-email@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ProspectIQ

# Apollo.io (free API key from app.apollo.io > Settings > API Keys)
APOLLO_API_KEY=your-apollo-api-key
